rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validProfile(userId) {
      return request.resource.data.keys().hasOnly([
        'uid', 'email', 'displayName', 'businessName', 'createdAt', 'updatedAt'
      ])
      && request.resource.data.uid == userId
      && request.resource.data.email is string
      && request.resource.data.email.size() <= 320
      && request.resource.data.displayName is string
      && request.resource.data.displayName.size() <= 120;
    }

    function validMovement() {
      return request.resource.data.keys().hasOnly([
        'type', 'concept', 'category', 'amount', 'date', 'invoice', 'method',
        'notes', 'recipeId', 'quantity', 'estimatedCost', 'estimatedProfit', 'channel',
        'party', 'partyId', 'partyRole', 'inventoryPurchase', 'createdAt', 'updatedAt'
      ])
      && request.resource.data.type in ['income', 'expense']
      && request.resource.data.concept is string
      && request.resource.data.concept.size() > 0
      && request.resource.data.concept.size() <= 240
      && request.resource.data.category is string
      && request.resource.data.amount is number
      && request.resource.data.amount > 0
      && request.resource.data.date is string
      && request.resource.data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
      && (!('channel' in request.resource.data) || (request.resource.data.channel is string && request.resource.data.channel.size() <= 40))
      && (!('method' in request.resource.data) || (request.resource.data.method is string && request.resource.data.method.size() <= 60))
      && (!('notes' in request.resource.data) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 2000))
      && (!('recipeId' in request.resource.data) || request.resource.data.recipeId is string)
      && (!('quantity' in request.resource.data) || (request.resource.data.quantity is number && request.resource.data.quantity > 0))
      && (!('estimatedCost' in request.resource.data) || (request.resource.data.estimatedCost is number && request.resource.data.estimatedCost >= 0))
      && (!('estimatedProfit' in request.resource.data) || request.resource.data.estimatedProfit is number)
      && (!('partyId' in request.resource.data) || request.resource.data.partyId is string)
      && (!('partyRole' in request.resource.data) || request.resource.data.partyRole in ['customer', 'supplier'])
      && (!('party' in request.resource.data) || request.resource.data.party == null || (
        request.resource.data.party is map
        && (!('name' in request.resource.data.party) || (request.resource.data.party.name is string && request.resource.data.party.name.size() <= 120))
        && (!('phone' in request.resource.data.party) || (request.resource.data.party.phone is string && request.resource.data.party.phone.size() <= 40))
        && (!('email' in request.resource.data.party) || (request.resource.data.party.email is string && request.resource.data.party.email.size() <= 320))
        && (!('taxId' in request.resource.data.party) || (request.resource.data.party.taxId is string && request.resource.data.party.taxId.size() <= 60))
        && (!('address' in request.resource.data.party) || (request.resource.data.party.address is string && request.resource.data.party.address.size() <= 240))
      ))
      && (!('inventoryPurchase' in request.resource.data) || request.resource.data.inventoryPurchase is map);
    }

    function validIngredient(ingredientId) {
      return request.resource.data.keys().hasOnly([
        'name', 'nameKey', 'unit', 'stock', 'min', 'cost', 'expiry', 'createdAt', 'updatedAt'
      ])
      && request.resource.data.name is string
      && request.resource.data.name.size() > 0
      && request.resource.data.name.size() <= 120
      && (!('nameKey' in request.resource.data) || request.resource.data.nameKey == ingredientId)
      && request.resource.data.unit in ['g', 'kg', 'ml', 'l', 'un']
      && request.resource.data.stock is number
      && request.resource.data.stock >= 0
      && (request.resource.data.unit != 'un' || (request.resource.data.stock % 1 == 0 && request.resource.data.min % 1 == 0))
      && request.resource.data.min is number
      && request.resource.data.min >= 0
      && request.resource.data.cost is number
      && request.resource.data.cost >= 0;
    }

    function validRecipe(recipeId) {
      return request.resource.data.keys().hasOnly([
        'name', 'nameKey', 'yield', 'price', 'labor', 'overhead', 'margin', 'ingredients',
        'overheadMode', 'overheadValue', 'profitMode', 'profitValue', 'priceSource', 'imageUrl',
        'createdAt', 'updatedAt'
      ])
      && request.resource.data.name is string
      && request.resource.data.name.size() > 0
      && request.resource.data.name.size() <= 120
      && (!('nameKey' in request.resource.data) || request.resource.data.nameKey == recipeId)
      && request.resource.data.yield is number
      && request.resource.data.yield > 0
      && request.resource.data.price is number
      && request.resource.data.price >= 0
      && request.resource.data.labor is number
      && request.resource.data.labor >= 0
      && request.resource.data.overhead is number
      && request.resource.data.overhead >= 0
      && request.resource.data.margin is number
      && request.resource.data.ingredients is list
      && (!('overheadMode' in request.resource.data) || request.resource.data.overheadMode in ['percent', 'fixed'])
      && (!('overheadValue' in request.resource.data) || (request.resource.data.overheadValue is number && request.resource.data.overheadValue >= 0))
      && (!('profitMode' in request.resource.data) || request.resource.data.profitMode in ['percent', 'fixed'])
      && (!('profitValue' in request.resource.data) || (request.resource.data.profitValue is number && request.resource.data.profitValue >= 0))
      && (!('priceSource' in request.resource.data) || request.resource.data.priceSource in ['manual', 'margin'])
      && (!('imageUrl' in request.resource.data) || (request.resource.data.imageUrl is string && request.resource.data.imageUrl.size() <= 700000));
    }

    function validParty(partyId) {
      return request.resource.data.keys().hasOnly([
        'id', 'role', 'name', 'phone', 'email', 'taxId', 'address', 'notes',
        'totalAmount', 'purchaseCount', 'operationCount', 'badge', 'lastMovementAt',
        'createdAt', 'updatedAt'
      ])
      && request.resource.data.id == partyId
      && request.resource.data.role in ['customer', 'supplier']
      && request.resource.data.name is string
      && request.resource.data.name.size() > 0
      && request.resource.data.name.size() <= 120
      && (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 40))
      && (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 320))
      && (!('taxId' in request.resource.data) || (request.resource.data.taxId is string && request.resource.data.taxId.size() <= 60))
      && (!('address' in request.resource.data) || (request.resource.data.address is string && request.resource.data.address.size() <= 240))
      && (!('notes' in request.resource.data) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 2000))
      && request.resource.data.totalAmount is number
      && request.resource.data.purchaseCount is number
      && request.resource.data.operationCount is number;
    }

    match /users/{userId} {
      allow read: if owns(userId);
      allow create: if owns(userId) && validProfile(userId)
        && request.resource.data.createdAt == request.time;
      allow update: if owns(userId) && validProfile(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      match /movements/{movementId} {
        allow read: if owns(userId);
        allow create: if owns(userId) && validMovement()
          && request.resource.data.createdAt == request.time;
        allow update: if owns(userId) && validMovement()
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if owns(userId);
      }

      match /ingredients/{ingredientId} {
        allow read: if owns(userId);
        allow create: if owns(userId) && validIngredient(ingredientId)
          && request.resource.data.createdAt == request.time;
        allow update: if owns(userId) && validIngredient(ingredientId)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if owns(userId);
      }

      match /recipes/{recipeId} {
        allow read: if owns(userId);
        allow create: if owns(userId) && validRecipe(recipeId)
          && request.resource.data.createdAt == request.time;
        allow update: if owns(userId) && validRecipe(recipeId)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if owns(userId);
      }

      match /parties/{partyId} {
        allow read: if owns(userId);
        allow create: if owns(userId) && validParty(partyId)
          && request.resource.data.createdAt == request.time;
        allow update: if owns(userId) && validParty(partyId)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if owns(userId);
      }

      match /stockMovements/{stockMovementId} {
        allow read: if owns(userId);
        allow create: if owns(userId)
          && request.resource.data.keys().hasOnly([
            'ingredientId', 'ingredientName', 'direction', 'reason', 'recipeId',
            'recipeName', 'quantity', 'unit', 'unitCost', 'totalCost', 'date',
            'createdAt', 'updatedAt'
          ])
          && request.resource.data.direction in ['in', 'out']
          && request.resource.data.quantity is number
          && request.resource.data.quantity > 0
          && request.resource.data.unitCost is number
          && request.resource.data.totalCost is number
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      match /{otherCollection}/{documentId} {
        allow read, write: if false;
      }
    }

    // Deny all documents outside the user's private workspace.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
